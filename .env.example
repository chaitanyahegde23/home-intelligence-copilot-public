APP_NAME=Home Intelligence Copilot API
APP_ENV=development
API_DOCS_ENABLED=false
API_ROOT_PATH=
POSTGRES_USER=home_intelligence
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=home_intelligence
DATABASE_URL=postgresql+psycopg://home_intelligence:replace-with-a-strong-local-password@localhost:5432/home_intelligence
MAX_UPLOAD_SIZE_BYTES=5242880
DOCUMENT_STORAGE_ROOT=../data/documents
MAX_DOCUMENT_SIZE_BYTES=20971520
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_TEXT_CHARS=2000000
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_TIMEOUT_SECONDS=120
DOCUMENT_EXTRACTION_STALE_SECONDS=300
DOCUMENT_CHUNK_MAX_CHARS=1000
GMAIL_INGESTION_ENABLED=false
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GMAIL_INGESTION_HOUSEHOLD_ID=00000000-0000-4000-8000-000000000001
GMAIL_ALLOWED_SENDERS=["parent@example.com"]
GMAIL_ALLOWED_SENDERS_JSON=["parent@example.com"]
GMAIL_REQUIRE_AUTHENTICATED_SENDER=true
GMAIL_SEARCH_QUERY=has:attachment filename:pdf -label:HIC/Imported -label:HIC/Failed
GMAIL_PROCESSED_LABEL=HIC/Imported
GMAIL_FAILED_LABEL=HIC/Failed
GMAIL_POLL_INTERVAL_SECONDS=300
GMAIL_MAX_MESSAGES_PER_POLL=25
GMAIL_INGESTION_STALE_SECONDS=900
GMAIL_MAX_ATTEMPTS=5
HOUSEHOLD_TIMEZONE=America/Los_Angeles
FINANCIAL_FEATURES_ENABLED=false
AUTH_MODE=local
AUTH_ALLOWED_ORIGIN=http://localhost:5173
AUTH_ALLOWED_HOSTS=["localhost:8000","127.0.0.1:8000"]
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=60
AUTH_ALLOWED_HOSTS_JSON=["localhost:8000","127.0.0.1:8000"]
AUTH_LOGIN_ATTEMPT_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=300
AI_ENABLED=false
OPENAI_API_KEY=replace-with-an-openai-project-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=600
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-remotely-managed-tunnel-token
